# Configure at least one provider. Keep real keys in .env (gitignored).
# Use openrouter/free or an exact catalog model ending in :free. Paid IDs are ignored.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Confirm account AND model free access in the provider dashboard before enabling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FREE_TIER_CONFIRMED=false

# Local attempted-request budgets, shared by every AI feature; reset at 00:00 UTC.
GEMINI_DAILY_LIMIT=20
GROQ_DAILY_LIMIT=50
OPENROUTER_DAILY_LIMIT=40
# Output-token ceiling (256–16384). Reasoning may share this budget on some models.
AI_MAX_OUTPUT_TOKENS=4096
QUIZ_CONTEXT_CHARS=6000
PORT=8000
MAX_UPLOAD_MB=25
OCR_MAX_PAGES=10
OCR_LANGUAGES=eng
# EMBEDDING_DEVICE=cpu
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# CORS_ORIGINS=http://localhost:3000
# DB_PATH=/absolute/persistent/path/documents.db
# DATA_DIR=/absolute/persistent/path/data
